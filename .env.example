# SecureVault Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Relational Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securevault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=securevault
POSTGRES_PORT=5432

# Redis Cache & Session Store
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Cryptography & Authentication Keys
# ENCRYPTION_KEY must be a 32-byte hex string (64 characters) for AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=securevault_jwt_signature_secret_32_bytes_long_change_me
SESSION_SECRET=securevault_super_secret_session_key_32_bytes_change_me

# Feature Flags
ENABLE_EMAIL_SIMULATION=true
